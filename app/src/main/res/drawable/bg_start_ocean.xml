<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#E0ECFF"
                android:centerColor="#EEF4FF"
                android:endColor="#DDF5FA"
                android:type="linear" />
        </shape>
    </item>
    <item android:top="-80dp" android:right="-70dp" android:width="320dp" android:height="320dp" android:gravity="top|end">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="160dp"
                android:startColor="#4D3B82F6"
                android:endColor="#003B82F6" />
        </shape>
    </item>
    <item android:bottom="-90dp" android:left="-80dp" android:width="340dp" android:height="340dp" android:gravity="bottom|start">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="170dp"
                android:startColor="#4006B6D4"
                android:endColor="#0006B6D4" />
        </shape>
    </item>
</layer-list>
