<?xml version="1.0" encoding="utf-8"?>
<!-- القائمة الرئيسية العائمة للمتصفح (تنبثق أسفل شريط الأدوات العلوي بأسلوب عصري عملي) -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="304dp"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="20dp"
    app:cardElevation="10dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="8dp">

            <!-- شريط الاختصارات السريعة العلوية (4 أيقونات عملية بصف واحد) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="6dp">

                <ImageButton
                    android:id="@+id/qaNewTab"
                    style="@style/Widget.SecureBrowser.IconButton.Card"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginHorizontal="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_section_card"
                    android:contentDescription="@string/menu_new_tab"
                    android:src="@drawable/ic_add"
                    android:tint="?attr/colorPrimary" />

                <ImageButton
                    android:id="@+id/qaFind"
                    style="@style/Widget.SecureBrowser.IconButton.Card"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginHorizontal="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_section_card"
                    android:contentDescription="@string/menu_find"
                    android:src="@drawable/ic_search"
                    android:tint="?attr/colorPrimary" />

                <ImageButton
                    android:id="@+id/qaShare"
                    style="@style/Widget.SecureBrowser.IconButton.Card"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginHorizontal="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_section_card"
                    android:contentDescription="@string/menu_share"
                    android:src="@drawable/ic_share"
                    android:tint="?attr/colorPrimary" />

                <ImageButton
                    android:id="@+id/qaSiteInfo"
                    style="@style/Widget.SecureBrowser.IconButton.Card"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginHorizontal="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_section_card"
                    android:contentDescription="@string/menu_site_info"
                    android:src="@drawable/ic_info"
                    android:tint="?attr/colorPrimary" />
            </LinearLayout>

            <!-- شريط التكبير المدمج الحي (+ / - دون إغلاق القائمة) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginHorizontal="12dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_section_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_zoom_in"
                    android:tint="?attr/colorPrimary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/menu_zoom"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnZoomOutInline"
                    style="@style/Widget.SecureBrowser.IconButton.Card"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:contentDescription="@string/menu_zoom_out"
                    android:src="@drawable/ic_zoom_out"
                    android:tint="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/txtZoomValue"
                    android:layout_width="52dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnZoomInInline"
                    style="@style/Widget.SecureBrowser.IconButton.Card"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:contentDescription="@string/menu_zoom_in"
                    android:src="@drawable/ic_zoom_in"
                    android:tint="?attr/colorOnSurface" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="12dp"
                android:layout_marginBottom="4dp"
                android:background="?attr/colorOutlineVariant" />

            <!-- قائمة الإجراءات الديناميكية -->
            <LinearLayout
                android:id="@+id/menuItemsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</com.google.android.material.card.MaterialCardView>
