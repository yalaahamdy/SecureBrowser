<?xml version="1.0" encoding="utf-8"?>
<!-- v1.9.0: حوار استيراد نسخة احتياطية — ملخص + وضع الدمج/الاستبدال + خيار استعادة الرمز -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/backupImportSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:alpha="0.7"
            android:text="@string/backup_import_mode_title"
            android:textSize="12sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/backupModeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbMerge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/backup_mode_merge"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/rbReplace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/backup_mode_replace"
                android:textSize="14sp" />
        </RadioGroup>

        <TextView
            android:id="@+id/backupReplaceWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="4dp"
            android:text="@string/backup_mode_replace_warn"
            android:textColor="@color/tempBannerForeground"
            android:textSize="12sp"
            android:visibility="gone" />

        <CheckBox
            android:id="@+id/backupRestorePin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/backup_restore_pin"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
