<?xml version="1.0" encoding="utf-8"?>
<!--
    صفحة البداية الافتراضية (v1.7.0 — إعادة تصميم كاملة):
    ترويسة هوية + شارة عدد المواقع + شبكة بطاقات المواقع المسموحة
    بأيقوناتها الحقيقية (Favicons)، وحالة فارغة أنيقة عند عدم وجود قواعد.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp">

        <FrameLayout
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_letter_tile">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_launcher_foreground"
                android:tint="?attr/colorPrimary" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/start_title"
            android:textColor="?attr/colorOnBackground"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.7"
            android:gravity="center"
            android:text="@string/start_subtitle"
            android:textColor="?attr/colorOnBackground"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/sitesCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_pill"
            android:paddingHorizontal="14dp"
            android:paddingVertical="5dp"
            android:textColor="?attr/colorOnPrimaryContainer"
            android:textSize="12sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/sitesGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:overScrollMode="never" />

        <LinearLayout
            android:id="@+id/emptyMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:alpha="0.85"
                android:contentDescription="@string/start_empty"
                android:src="@drawable/ic_shield_check"
                android:tint="?attr/colorPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:alpha="0.7"
                android:gravity="center"
                android:text="@string/start_empty"
                android:textColor="?attr/colorOnBackground"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
