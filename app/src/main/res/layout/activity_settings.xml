<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/colorPrimary"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnToolbarBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_back"
            android:tint="@color/browserBarForeground" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/settings_title"
            android:textColor="@color/browserBarForeground"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="2dp"
                android:paddingTop="8dp">

                <include
                    android:id="@+id/cardTheme"
                    layout="@layout/row_action_card" />

                <include
                    android:id="@+id/cardLanguage"
                    layout="@layout/row_action_card" />

                <include
                    android:id="@+id/cardSearchEngine"
                    layout="@layout/row_action_card" />

                <include
                    android:id="@+id/cardHomepage"
                    layout="@layout/row_action_card" />

                <include
                    android:id="@+id/cardZoom"
                    layout="@layout/row_action_card" />
            </LinearLayout>

            <TextView
                android:id="@+id/settingsNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:alpha="0.55"
                android:gravity="center"
                android:paddingHorizontal="22dp"
                android:text="@string/settings_note"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
