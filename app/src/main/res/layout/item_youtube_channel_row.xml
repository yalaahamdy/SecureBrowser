<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_section_card"
    android:gravity="center_vertical"
    android:minHeight="68dp"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp">

    <TextView
        android:id="@+id/channelLetter"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_letter_tile"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:textColor="?attr/colorOnPrimaryContainer"
        android:textSize="17sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/channelTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/colorOnBackground"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/channelSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:alpha="0.65"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/colorOnBackground"
            android:textSize="12sp" />
    </LinearLayout>

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switchChannelEnabled"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp" />

    <ImageButton
        android:id="@+id/btnDeleteChannel"
        style="@style/Widget.SecureBrowser.IconButton.Card"
        android:contentDescription="@string/delete"
        android:src="@drawable/ic_delete"
        android:tint="@color/colorError" />
</LinearLayout>
