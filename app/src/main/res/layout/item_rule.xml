<?xml version="1.0" encoding="utf-8"?>
<!--
    صف قاعدة القائمة البيضاء (v1.7.0): أيقونة الموقع الحقيقية بدل الدرع
    الثابت + النطاق ونطاق السماح — إدارة أجمل وأوضح.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="8dp">

    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp">

        <TextView
            android:id="@+id/ruleLetter"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_letter_tile"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textColor="?attr/colorOnPrimaryContainer"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ruleIcon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:contentDescription="@string/cd_site_icon"
            android:scaleType="fitCenter"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/ruleHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/colorOnBackground"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ruleTypeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:alpha="0.65"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/colorOnBackground"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnDeleteRule"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/delete"
        android:src="@drawable/ic_delete"
        android:tint="@color/colorError" />
</LinearLayout>
