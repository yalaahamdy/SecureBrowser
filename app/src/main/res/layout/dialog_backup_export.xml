<?xml version="1.0" encoding="utf-8"?>
<!-- v1.9.0: حوار تصدير كل بيانات المتصفح — ملخص الأقسام + خيار تضمين رمز الوالدين -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="8dp">

    <TextView
        android:id="@+id/backupExportSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="4dp"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="14sp" />

    <CheckBox
        android:id="@+id/backupIncludePin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/backup_include_pin"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:alpha="0.7"
        android:text="@string/backup_export_note"
        android:textSize="12sp" />
</LinearLayout>
