<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- مجلد تنزيلات التطبيق الخاص (getExternalFilesDir/Download) -->
    <external-files-path
        name="downloads"
        path="Download/" />
    <!-- بديل داخلي للأجهزة بلا تخزين خارجي -->
    <files-path
        name="internal_downloads"
        path="downloads/" />
    <!-- مجلد التنزيلات الافتراضي العام للهاتف (/storage/emulated/0/Download) -->
    <external-path
        name="public_downloads"
        path="Download/" />
    <!-- مجلدات حزم التحديثات التلقائية (APK Updates) -->
    <cache-path
        name="updates_cache"
        path="updates/" />
    <external-cache-path
        name="updates_external_cache"
        path="updates/" />
</paths>
