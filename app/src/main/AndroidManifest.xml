<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- v1.4.0: فتح بوابة الوالدين بالبصمة (اختياري للوالد) — صلاحية عادية بلا موافقة مستخدم -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- v1.9.0: قارئ QR المدمج — الكاميرا للمسح فقط، لا تصوير ولا تخزين -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!-- رؤية حزم التطبيقات الخارجية المدعومة (Android 11+) — v1.2.0:
         أُضيفت عملاء بديلة (Telegram X)، ومشغلات الوسائط المعروفة،
         ومخططات التطبيقات/المشغلات، وأنواع mime للفيديو/الصوت —
         بدونها يرجع resolveActivity فارغًا فتظهر "لا يوجد تطبيق" وهو مثبت. -->
    <queries>
        <package android:name="org.telegram.messenger" />
        <package android:name="org.telegram.plus" />
        <package android:name="org.thunderdog.challegram" />
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.google.android.apps.maps" />
        <package android:name="org.videolan.vlc" />
        <package android:name="com.mxtech.videoplayer.ad" />
        <package android:name="com.mxtech.videoplayer.pro" />
        <package android:name="com.newin.nplayer.pro" />
        <package android:name="com.kmplayer" />
        <package android:name="com.kmplayerfree" />
        <package android:name="video.player.vplayer" />
        <package android:name="org.bsplayer.v2" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="tg" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="whatsapp" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="vnd.youtube" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="rtsp" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="vlc" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="mxplayer" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="nplayer" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="kmplayer" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="splayer" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="video/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="audio/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.SecureBrowser"
        tools:targetApi="tiramisu">

        <!-- Splash / gate: routes to PIN setup or browser -->
        <activity
            android:name=".ui.GateActivity"
            android:exported="true"
            android:theme="@style/Theme.SecureBrowser.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- First-run parental PIN creation -->
        <activity
            android:name=".ui.SetupPinActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" />

        <!-- Main browser shell -->
        <activity
            android:name=".browser.BrowserActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|navigation"
            android:exported="false"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize" />

        <!-- Parental dashboard (PIN-locked, auto-lock on inactivity) -->
        <activity
            android:name=".parental.ParentalActivity"
            android:exported="false" />

        <activity android:name=".parental.WhitelistActivity" android:exported="false" />
        <activity android:name=".parental.AddWebsiteActivity" android:exported="false" />
        <activity android:name=".parental.TempAccessActivity" android:exported="false" />
        <activity android:name=".parental.HistoryActivity" android:exported="false" />
        <activity android:name=".parental.BlockedActivityActivity" android:exported="false" />
        <activity android:name=".parental.DownloadsActivity" android:exported="false" />
        <activity android:name=".parental.RecentActivityActivity" android:exported="false" />
        <activity android:name=".parental.ParentalSettingsActivity" android:exported="false" />

        <!-- Child-level appearance settings (cannot touch security) -->
        <activity
            android:name=".browser.SettingsActivity"
            android:exported="false" />

        <!-- v1.9.0: قارئ رموز QR المدمج -->
        <activity
            android:name=".ui.qr.QrScannerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" />

        <!-- مشاركة/فتح الملفات المنزّلة عبر FileProvider -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
